#!/bin/sh
# Run inside the dedicated gateway VM, never around the desktop agent.
set -eu
umask 077
config_dir=${1:-/etc/credential-gateway}
install -d -m 700 /run/credential-gateway
exec /usr/local/bin/dotenvx run --quiet --strict --no-native --no-armor \
    --no-1password --no-bitwarden -f "$config_dir/.env" \
    -fk "$config_dir/.env.keys" -- \
    /usr/local/bin/smolvm-secret-broker "$config_dir/config.json"
