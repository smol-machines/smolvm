[Unit]
Description=Smol credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=smolvm-secret-broker
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=no
LoadCredential=config:/etc/smolvm-secret-broker/config.json
LoadCredential=key:/etc/smolvm-secret-broker/server.key
LoadCredential=leaf:/etc/smolvm-secret-broker/server-chain.pem
LoadCredential=ca:/etc/smolvm-secret-broker/upstream-ca.pem
LoadCredential=access:/etc/smolvm-secret-broker/access
LoadCredential=secret:/etc/smolvm-secret-broker/secret
ExecStart=/usr/local/libexec/smolvm-secret-broker-start
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
UMask=0077
MemoryMax=256M
TasksMax=96

[Install]
WantedBy=multi-user.target
