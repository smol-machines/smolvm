#!/bin/sh
# Installed root-owned, not writable by the desktop/agent identity.
set -eu
: "${CREDENTIALS_DIRECTORY:?systemd credentials are required}"
: "${RUNTIME_DIRECTORY:?private systemd runtime directory is required}"
umask 077
# systemd can expose credentials as root:root 0440 with namespace ACLs. Copy to
# private tmpfs files owned by this service instead of weakening broker checks.
for item in config key leaf ca access secret; do
    install -m 600 "$CREDENTIALS_DIRECTORY/$item" "$RUNTIME_DIRECTORY/$item"
done
exec /usr/local/bin/smolvm-secret-broker "$RUNTIME_DIRECTORY/config"
